# macOS
.DS_Store

# magpie's build outputs (note: build/ itself is tracked source, do not ignore it)
/magpie
/magpie.exe
/magpie.app/
/dist/
/magpie-dev
/rsrc_windows_*.syso
/magpie-dev-backend
/magpie-dev.new

# Echo / MyGo
/mygo-dev
# the shell binary `make echo` writes, and mygo build output
/echo
/build-echo/
*.test
*.out

# Node (frontend tooling)
node_modules/
npm-debug.log*
pnpm-debug.log*

# VitePress (the docs site under site/docs): its cache and its build
# output are not source, and are written again on every build
site/docs/.vitepress/cache/
site/docs/.vitepress/dist/

# Editors
.idea/
.vscode/
